LIVEKIT_REALTIME_PORT=4200
LIVEKIT_REALTIME_SERVICE_SECRET=livekit_realtime_shared_secret
ASSISTANT_CALLBACK_URL=http://localhost:4100
ASSISTANT_SERVICE_SECRET=assistant_shared_secret
ELEVEN_API_KEY=
LIVEKIT_REALTIME_ROOM_CONNECT_TIMEOUT_SECONDS=20
LIVEKIT_REALTIME_ASSISTANT_CALLBACK_TIMEOUT_SECONDS=20
LIVEKIT_REALTIME_AUDIO_STREAM_CAPACITY=250
LIVEKIT_REALTIME_AUDIO_STREAM_BACKPRESSURE_WARN_MS=200
MEETING_RECORDINGS_DIR=/tmp/readymeet-recordings
# Realtime captions use the direct ElevenLabs Python plugin with Scribe v2 Realtime.
# Keep language empty so ElevenLabs automatic language detection stays enabled.
LIVEKIT_REALTIME_STT_MODEL=scribe_v2_realtime
LIVEKIT_REALTIME_STT_LANGUAGE=
# Use ElevenLabs VAD commits so captions finalize promptly even while voice mode
# is off. The silence threshold is valid from 0.3 to 3.0 seconds.
LIVEKIT_REALTIME_STT_VAD_SILENCE_THRESHOLD_SECONDS=0.5
LIVEKIT_REALTIME_STT_VAD_THRESHOLD=0.4
LIVEKIT_REALTIME_STT_VAD_MIN_SPEECH_DURATION_MS=100
LIVEKIT_REALTIME_STT_VAD_MIN_SILENCE_DURATION_MS=100

# Speech gating. Each participant otherwise holds an STT stream — and so a
# ElevenLabs realtime session — for the whole meeting whether or not they ever
# speak. off = today's behaviour; shadow = log what gating would do while
# keeping streams open; on = actually gate.
LIVEKIT_REALTIME_STT_GATE=off
# Seconds a stream lingers after speech stops. This is the knob that sets
# concurrency: tune it from shadow-mode metrics, not from first principles.
LIVEKIT_REALTIME_STT_GATE_HOLD_OPEN_SECONDS=8
LIVEKIT_REALTIME_STT_GATE_MIN_OPEN_SECONDS=3
LIVEKIT_REALTIME_STT_GATE_PREBUFFER_SECONDS=1.5
# Max concurrently open STT streams in THIS process (0 = unlimited). The
# meeting-agent is a separate process drawing on the same provider cap with no
# budget of its own, so leave room for it:
#   capacity = plan cap - peak concurrent push-to-talk turns - headroom
LIVEKIT_REALTIME_STT_GATE_ADMISSION_CAPACITY=0
LIVEKIT_REALTIME_STT_GATE_ADMISSION_WAIT_SECONDS=5
LIVEKIT_REALTIME_STT_GATE_MAX_BLOCKED_BUFFER_SECONDS=30
