# Shared
DATABASE_URL=postgres://postgres:postgres@localhost:5432/readymeet

# API
API_PORT=4000
API_BASE_URL=http://localhost:4000
# Optional. Leave empty for normal local dev polling; set to a stable HTTPS tunnel
# only when testing provider webhooks locally.
CALENDAR_WEBHOOK_BASE_URL=
AUTH_JWT_SECRET=dev_super_secret_change_me
# Optional comma-separated admin emails. Empty falls back to sam@ready.app.
ADMIN_EMAIL=
LIVEKIT_URL=wss://your-livekit-host
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
LIVEKIT_WEBHOOK_SECRET=your_livekit_webhook_secret
LIVEKIT_DIAL_IN_NUMBER=
ASSISTANT_SERVICE_URL=http://localhost:4100
ASSISTANT_SERVICE_SECRET=assistant_shared_secret
ASSISTANT_SERVICE_REQUEST_TIMEOUT_MS=12000
ASSISTANT_SERVICE_TRANSCRIPTION_STOP_TIMEOUT_MS=70000
AUTH_EXCHANGE_SECRET=dev_auth_exchange_secret_change_me
OAUTH_TOKEN_ENCRYPTION_KEY=dev_oauth_token_encryption_key_change_me
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
LINEAR_REDIRECT_URI=http://localhost:4000/v1/integrations/linear/callback
# Slack app credentials (https://api.slack.com/apps): add the redirect URL and
# bot scopes channels:read, groups:read, chat:write, chat:write.public,
# channels:manage, groups:write.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:4000/v1/integrations/slack/callback
OPENAI_SLACK_CLASSIFIER_MODEL=gpt-5.4-mini
PARALLEL_API_KEY=
AMBIENT_CONTEXT_ENABLED=true
OPENAI_AMBIENT_CONTEXT_MODEL=gpt-5.4-nano
# Research synthesis verifies identities separately from lightweight detection.
OPENAI_AMBIENT_RESEARCH_MODEL=gpt-5.4-mini
OPENAI_AMBIENT_CONTEXT_TIMEOUT_MS=20000
# Ambient identity images and meeting assets use this private object-storage backend.
MAIL_OBJECT_STORAGE_ENDPOINT=
MAIL_OBJECT_STORAGE_BUCKET=
MAIL_OBJECT_STORAGE_REGION=auto
MAIL_OBJECT_STORAGE_ACCESS_KEY_ID=
MAIL_OBJECT_STORAGE_SECRET_ACCESS_KEY=
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:4000/v1/integrations/calendar/google_calendar/callback
OUTLOOK_CALENDAR_CLIENT_ID=
OUTLOOK_CALENDAR_CLIENT_SECRET=
OUTLOOK_CALENDAR_REDIRECT_URI=http://localhost:4000/v1/integrations/calendar/outlook_calendar/callback

# Stripe billing (run `npm run setup:stripe-catalog` in api to create
# the sandbox products and print the price ids)
# Workspace invitations (Resend). Leave RESEND_API_KEY empty in local dev to
# skip sending; invitations are still created.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Ready <invitations@ready.app>
WORKSPACE_INVITE_EXPIRY_DAYS=14

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BUSINESS_MONTHLY=
STRIPE_PRICE_BUSINESS_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_MAX_MONTHLY=
STRIPE_PRICE_MAX_YEARLY=
STRIPE_PRICE_CREDIT_TOPUP=
BILLING_MONTHLY_PLAN_INCLUDED_CREDITS=250

# Assistant
ASSISTANT_PORT=4100
LIVEKIT_REALTIME_SERVICE_URL=http://localhost:4200
LIVEKIT_REALTIME_SERVICE_SECRET=livekit_realtime_shared_secret
LIVEKIT_REALTIME_REQUEST_TIMEOUT_MS=12000
LIVEKIT_REALTIME_STOP_REQUEST_TIMEOUT_MS=60000
# Python realtime transcriber recording storage (not the Node assistant).
MEETING_RECORDINGS_DIR=/tmp/readymeet-recordings
LIVEKIT_URL=wss://your-livekit-host
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
LIVEKIT_ROOM_ASSISTANT_NAME=readymeet-meeting-agent
# Remote input counting is disabled until endpoint pricing is verified.
# Without counting, supported plaintext calls reserve a conservative local input bound.
# Set free only after operator confirmation that /responses/input_tokens has no fee.
OPENAI_INPUT_TOKEN_COUNT_BILLING=unverified
# Gateway is optional; an OpenAI key alone supports meeting notes.
AI_GATEWAY_API_KEY=
OPENAI_API_KEY=
# Required by the direct ElevenLabs Python STT plugin in both voice services.
ELEVEN_API_KEY=
OPENAI_MEETING_SUMMARY_MODEL=gpt-5.5
OPENAI_MEETING_SUMMARY_PROGRESS_DELAY_MS=500
OPENAI_MEETING_SUMMARY_TIMEOUT_MS=12000
OPENAI_MEETING_EXTRACTION_MODEL=gpt-5.4-mini
OPENAI_MEETING_SNAPSHOT_MODEL=gpt-5.6-sol
OPENAI_MEETING_TASKS_MODEL=gpt-5.6-sol
OPENAI_CAPABILITY_SELECTION_MODEL=gpt-5.4-nano
OPENAI_CAPABILITY_WORKFLOW_MODEL=gpt-5.4-mini
# Optional override of the shared built-in model-price table; unknown paid models fail closed.
# Omit this setting to use the default rates below.
# Standard global processing rates; update these from the provider catalog before rollout.
# https://developers.openai.com/api/docs/models (long-context and cache-write pricing apply).
OPENAI_MODEL_PRICES_JSON={"gpt-5.6-sol":{"inputPerMillion":4,"cachedInputPerMillion":0.4,"outputPerMillion":20,"maxContextTokens":1050000,"longContext":{"thresholdTokens":272000,"inputMultiplier":2,"outputMultiplier":1.5},"cacheWritePerMillion":5},"gpt-5.5":{"inputPerMillion":5,"cachedInputPerMillion":0.5,"outputPerMillion":30,"maxContextTokens":1050000,"longContext":{"thresholdTokens":272000,"inputMultiplier":2,"outputMultiplier":1.5}},"gpt-5.4":{"inputPerMillion":2.5,"cachedInputPerMillion":0.25,"outputPerMillion":15,"maxContextTokens":1050000,"longContext":{"thresholdTokens":272000,"inputMultiplier":2,"outputMultiplier":1.5}},"gpt-5.4-mini":{"inputPerMillion":0.75,"cachedInputPerMillion":0.075,"outputPerMillion":4.5,"maxContextTokens":400000,"longContext":{"thresholdTokens":272000,"inputMultiplier":1,"outputMultiplier":1}},"gpt-5.4-nano":{"inputPerMillion":0.2,"cachedInputPerMillion":0.02,"outputPerMillion":1.25,"maxContextTokens":400000,"longContext":{"thresholdTokens":272000,"inputMultiplier":1,"outputMultiplier":1}},"gpt-4o-mini":{"inputPerMillion":0.15,"cachedInputPerMillion":0.075,"outputPerMillion":0.6,"maxContextTokens":128000},"gpt-4o-transcribe":{"inputPerMillion":6,"outputPerMillion":10},"gpt-4o-mini-transcribe":{"inputPerMillion":3,"outputPerMillion":5},"gpt-5.6-luna":{"inputPerMillion":0.2,"cachedInputPerMillion":0.02,"cacheWritePerMillion":0.25,"outputPerMillion":1.2,"maxContextTokens":1050000,"longContext":{"thresholdTokens":272000,"inputMultiplier":2,"outputMultiplier":1.5}},"gpt-6-luna":{"inputPerMillion":0.1,"cachedInputPerMillion":0.01,"cacheWritePerMillion":0.125,"outputPerMillion":0.5,"maxContextTokens":1050000,"longContext":{"thresholdTokens":272000,"inputMultiplier":2,"outputMultiplier":1.5}}}

# Meeting agent
OPENAI_MEETING_ASSISTANT_MODEL=gpt-4o-mini
OPENAI_MEETING_ASSISTANT_TTS_MODEL=gpt-4o-mini-tts
OPENAI_MEETING_ASSISTANT_REALTIME_MODEL=gpt-live-1
OPENAI_MEETING_ASSISTANT_LIVE_BACKEND_MODEL=gpt-5.6-luna
OPENAI_MEETING_ASSISTANT_VOICE=marin
OPENAI_MEETING_ASSISTANT_WEB_SEARCH_ENABLED=true
OPENAI_MEETING_ASSISTANT_WEB_SEARCH_CONTEXT_SIZE=medium
# Meeting assistant STT uses the direct ElevenLabs Python plugin.
# Keep language empty so automatic language detection stays enabled.
MEETING_ASSISTANT_STT_MODEL=scribe_v2_realtime
MEETING_ASSISTANT_STT_LANGUAGE=
# The group-mode assistant holds an STT stream open for the whole meeting even
# though audio only flows during a push-to-talk turn. Gating opens it on the
# first frame of a turn and closes it after the turn goes idle.
MEETING_ASSISTANT_STT_GATE=false
MEETING_ASSISTANT_STT_GATE_IDLE_SECONDS=5

# LiveKit realtime Python service
LIVEKIT_REALTIME_PORT=4200
ASSISTANT_CALLBACK_URL=http://localhost:4100
LIVEKIT_REALTIME_ROOM_CONNECT_TIMEOUT_SECONDS=20
LIVEKIT_REALTIME_ASSISTANT_CALLBACK_TIMEOUT_SECONDS=20
LIVEKIT_REALTIME_AUDIO_STREAM_CAPACITY=250
LIVEKIT_REALTIME_AUDIO_STREAM_BACKPRESSURE_WARN_MS=200
LIVEKIT_REALTIME_STT_MODEL=scribe_v2_realtime
LIVEKIT_REALTIME_STT_LANGUAGE=
# ElevenLabs server VAD commits each utterance after 500 ms of silence. Without
# this, its manual strategy can wait about 36 seconds before auto-committing.
LIVEKIT_REALTIME_STT_VAD_SILENCE_THRESHOLD_SECONDS=0.5
LIVEKIT_REALTIME_STT_VAD_THRESHOLD=0.4
LIVEKIT_REALTIME_STT_VAD_MIN_SPEECH_DURATION_MS=100
LIVEKIT_REALTIME_STT_VAD_MIN_SILENCE_DURATION_MS=100
# Speech gating: off | shadow | on. See livekit-realtime/.env.example
# for the full knob set and what each one trades off.
LIVEKIT_REALTIME_STT_GATE=off
LIVEKIT_REALTIME_STT_GATE_HOLD_OPEN_SECONDS=8
LIVEKIT_REALTIME_STT_GATE_ADMISSION_CAPACITY=0

# Web
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_AMBIENT_CONTEXT_ENABLED=true
INTERNAL_API_BASE_URL=http://localhost:4000
AUTH_SECRET=replace_with_a_long_random_secret
AUTH_TRUST_HOST=true
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/common/v2.0

# Error tracking (optional; applies to the API and assistant services).
# Leave empty to disable — all Sentry capture calls become no-ops.
SENTRY_DSN=
SENTRY_ENVIRONMENT=

# Automatic meeting-based memory (apply migrations before starting the API).
MEMORY_ENABLED=true

# Post-meeting Ashby review: enable only after applying migration 0115 and validating detection.
ASHBY_POST_MEETING_REVIEW_ENABLED=false
ASHBY_REVIEW_MODEL=gpt-5.4-mini
ASHBY_REVIEW_JEV_MODEL=jev-latest
# Uses the existing TYPESAFE_API_KEY and OPENAI_API_KEY server-side.

# Enable only after privacy review and web/API deployment together.
GUEST_RECOGNITION_ENABLED=false

# Same random secret (at least 32 characters) on web and API for guest proxy rate limiting.
# GUEST_RECOGNITION_PROXY_SECRET=

# Realtime meeting tracking prototype (migrations 0122/0123 required).
# Uses TYPESAFE_API_KEY and OPENAI_API_KEY; retention remains unchanged.
MEETING_TRACKER_ENABLED=false
MEETING_TRACKER_MODEL=gpt-6-luna

# Required in production for every service that reads or writes protected meeting content.
# Each value is a 32-byte key encoded as 64 hex characters (`openssl rand -hex 32`).
# Keep the lookup key stable; replacing it breaks fingerprint lookups.
# NODE_ENV=development uses a local-only key provider when both values are empty.
# That provider is refused when NODE_ENV is production.
MEETING_CONTENT_WRAPPING_KEY=
MEETING_CONTENT_LOOKUP_KEY=
