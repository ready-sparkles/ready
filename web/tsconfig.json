{
	"extends": "../tsconfig.base.json",
	"compilerOptions": {
		"plugins": [
			{
				"name": "next"
			}
		],
		"jsx": "preserve",
		"noEmit": true,
		"incremental": true,
		"allowJs": true
	},
	"include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", "**/*.d.ts", ".next/types/**/*.ts"],
	"exclude": ["node_modules", "adapters/primary/google-calendar/dist"]
}
