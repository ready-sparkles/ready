}

model agentConnectors {
  id                                        String                                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                                   String @map("user_id")                                     @db.Uuid
  agentProfileId                          String @map("agent_profile_id")                                     @db.Uuid
  provider                                  String                                     @db.VarChar(64)
  status                                    String                                     @default("disconnected") @db.VarChar(32)
  scope                                     String                                     @default("private") @db.VarChar(32)
  externalAccountEmail                    String? @map("external_account_email")                                    @db.VarChar(255)
  createdAt                                DateTime @map("created_at")                                   @default(now()) @db.Timestamptz(6)
  updatedAt                                DateTime @map("updated_at")                                   @default(now()) @db.Timestamptz(6)
  providerAccountId                       String? @map("provider_account_id")
  providerEmail                            String? @map("provider_email")                                    @db.VarChar(255)
  providerTenantId                        String? @map("provider_tenant_id")                                    @db.VarChar(255)
  scopes                                    Json                                       @default("[]")
  syncStatus                               String @map("sync_status")                                     @default("idle") @db.VarChar(64)
  accountKind                              String? @map("account_kind")                                    @db.VarChar(32)
  connectedAt                              DateTime? @map("connected_at")                                  @db.Timestamptz(6)
  lastSyncedAt                            DateTime? @map("last_synced_at")                                  @db.Timestamptz(6)
  disconnectedAt                           DateTime? @map("disconnected_at")                                  @db.Timestamptz(6)
  deletedAt                                DateTime? @map("deleted_at")                                  @db.Timestamptz(6)
  nullAccountKey                          String? @map("null_account_key")                                    @unique(map: "agent_connectors_null_account_key_uidx") @default(dbgenerated("\nCASE\n    WHEN ((provider_account_id IS NULL) AND (deleted_at IS NULL)) THEN (((user_id)::text || ':'::text) || (provider)::text)\n    ELSE NULL::text\nEND"))
  activeAccountKey                        String? @map("active_account_key")                                    @unique(map: "agent_connectors_active_account_key_uidx") @default(dbgenerated("\nCASE\n    WHEN ((provider_account_id IS NOT NULL) AND (deleted_at IS NULL)) THEN (((((user_id)::text || ':'::text) || (provider)::text) || ':'::text) || provider_account_id)\n    ELSE NULL::text\nEND"))
  agentConnectorSecrets                   agentConnectorSecrets[]
  agentProfiles                            agentProfiles                             @relation(fields: [agentProfileId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users                                     users                                      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  agentToolInvocations                    agentToolInvocations[]
  calendarEventPreps                      calendarEventPreps[]
  calendarReadyLinks                      calendarReadyLinks[]
  calendarSyncSubscriptions               calendarSyncSubscriptions[]
  linearTaskReviewRuns                   linearTaskReviewRuns[]
  pendingGoogleAddonCalendarCredentials pendingGoogleAddonCalendarCredentials?
  @@map("agent_connectors")
}

