  source                                              String   @default("admin_manual") @db.VarChar(32)
  createdAt                                          DateTime @map("created_at") @default(now()) @db.Timestamptz(6)
  usersAdminUserPlanChangesActorUserIdTousers  users?   @relation("admin_user_plan_changes_actor_user_idTousers", fields: [actorUserId], references: [id], onUpdate: NoAction)
  usersAdminUserPlanChangesTargetUserIdTousers users    @relation("admin_user_plan_changes_target_user_idTousers", fields: [targetUserId], references: [id], onDelete: Cascade, onUpdate: NoAction)
