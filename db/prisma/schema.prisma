  activeOwnerKey String? @map("active_owner_key")    @unique(map: "workspace_memberships_active_owner_key_uidx") @default(dbgenerated("\nCASE\n    WHEN ((role = 'owner'::text) AND (status = 'active'::text)) THEN (workspace_id)::text\n    ELSE NULL::text\nEND"))
  users            users      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  workspaces       workspaces @relation(fields: [workspaceId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([workspaceId, userId], map: "workspace_memberships_workspace_user_uidx")
  @@map("workspace_memberships")
}

model workspaceTaskSections {
  id                                                      String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId                                            String @map("workspace_id")                     @unique(map: "workspace_task_sections_default_uidx", where: raw("((is_default = true) AND (deleted_at IS NULL))")) @db.Uuid
  title                                                   String
  position                                                Int                        @default(0)
  isDefault                                              Boolean @map("is_default")                    @default(false)
  createdByUserId                                      String? @map("created_by_user_id")                    @db.Uuid
  updatedByUserId                                      String? @map("updated_by_user_id")                    @db.Uuid
  createdAt                                              DateTime @map("created_at")                   @default(now()) @db.Timestamptz(6)
  updatedAt                                              DateTime @map("updated_at")                   @default(now()) @db.Timestamptz(6)
  deletedAt                                              DateTime? @map("deleted_at")                  @db.Timestamptz(6)
  assignedTaskPlacements                                assignedTaskPlacements[]
  usersWorkspaceTaskSectionsCreatedByUserIdTousers users?                     @relation("workspace_task_sections_created_by_user_idTousers", fields: [createdByUserId], references: [id], onUpdate: NoAction)
  usersWorkspaceTaskSectionsUpdatedByUserIdTousers users?                     @relation("workspace_task_sections_updated_by_user_idTousers", fields: [updatedByUserId], references: [id], onUpdate: NoAction)
  workspaces                                              workspaces                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  titleFingerprint String @map("title_fingerprint") @default(dbgenerated())

  @@unique([workspaceId, titleFingerprint], map: "workspace_task_sections_title_uidx", where: raw("(deleted_at IS NULL)"))
  @@map("workspace_task_sections")
}

