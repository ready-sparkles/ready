model agentConnectorSecrets {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agentConnectorId String @map("agent_connector_id")           @db.Uuid
  secretRef         String @map("secret_ref")
  encryptionVersion String @map("encryption_version")           @default("v1") @db.VarChar(32)
  createdAt         DateTime @map("created_at")         @default(now()) @db.Timestamptz(6)
  rotatedAt         DateTime? @map("rotated_at")        @db.Timestamptz(6)
  agentConnectors   agentConnectors @relation(fields: [agentConnectorId], references: [id], onDelete: Cascade, onUpdate: NoAction)
