FROM node:22-bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates openssl \
    && rm -rf /var/lib/apt/lists/* \
    && corepack enable

WORKDIR /app
COPY . .
RUN corepack install && corepack pnpm install --frozen-lockfile

# Prisma validates this URL during generation but does not connect to it.
RUN DATABASE_URL=postgresql://build:build@localhost:5432/build corepack pnpm --filter @readymeet/db generate

ARG NODE_WORKSPACE=@readymeet/api
ARG NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
ARG NEXT_PUBLIC_DEBUG_NEW_EXTRACTION=false
ARG NEXT_PUBLIC_DEBUG_SELECTION=false
ARG NEXT_PUBLIC_AMBIENT_CONTEXT_ENABLED=true
RUN node -e 'require("node:assert/strict").ok(["@readymeet/api", "@readymeet/assistant-service", "@readymeet/web"].includes(process.env.NODE_WORKSPACE))'
# Next.js imports the auth schema while building; real secrets are required at runtime.
RUN AUTH_SECRET=build-only-not-a-runtime-secret corepack pnpm --filter "$NODE_WORKSPACE" --fail-if-no-match build

ENV NODE_ENV=production
ENV NODE_WORKSPACE=$NODE_WORKSPACE
CMD ["sh", "-c", "exec corepack pnpm --filter \"$NODE_WORKSPACE\" start"]
