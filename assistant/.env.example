ASSISTANT_PORT=4100
# Required in production: use the reachable API origin (no /v1 suffix).
API_BASE_URL=http://localhost:4000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/readymeet
ASSISTANT_SERVICE_SECRET=assistant_shared_secret
LIVEKIT_REALTIME_SERVICE_URL=http://localhost:4200
LIVEKIT_REALTIME_SERVICE_SECRET=livekit_realtime_shared_secret
LIVEKIT_REALTIME_REQUEST_TIMEOUT_MS=12000
LIVEKIT_URL=wss://your-livekit-host
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
LIVEKIT_ROOM_ASSISTANT_NAME=readymeet-meeting-agent
OPENAI_API_KEY=
OPENAI_MEETING_SUMMARY_MODEL=gpt-5.5
OPENAI_MEETING_SUMMARY_PROGRESS_DELAY_MS=500
OPENAI_MEETING_SUMMARY_TIMEOUT_MS=12000
OPENAI_MEETING_EXTRACTION_MODEL=gpt-5.4-mini
OPENAI_MEETING_SNAPSHOT_MODEL=gpt-5.6-sol
OPENAI_MEETING_TASKS_MODEL=gpt-5.6-sol
OPENAI_CAPABILITY_SELECTION_MODEL=gpt-5.4-nano
OPENAI_CAPABILITY_WORKFLOW_MODEL=gpt-5.4-mini
# Optional. Blank uses the built-in tariffs (shared/domain/openai-usage.ts). Entries override the
# built-in fields of the same model; a text model the defaults do not know needs maxContextTokens.
OPENAI_MODEL_PRICES_JSON=

# Optional override; defaults to OPENAI_MEETING_SNAPSHOT_MODEL.
# OPENAI_MEMORY_MODEL=gpt-5.6-sol
