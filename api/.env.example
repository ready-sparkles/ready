# API-local overrides only. Shared local values come from the repo-root `.env`.
# Copy this file only when the API needs service-specific local overrides.

# Optional single admin email. Empty disables admin access; configure privately per deployment.
# ADMIN_EMAIL=

# Server-side only: the API uses this to mint browser-safe Ably tokens and
# publish realtime events during requests. Never expose raw Ably keys to the web app.
ABLY_API_KEY=
ABLY_CLIENT_TTL_MS=600000


# Proactive person/company context. Every Search request is forced to Turbo.
AMBIENT_CONTEXT_ENABLED=true
TYPESAFE_API_KEY=
OPENAI_AMBIENT_CONTEXT_MODEL=gpt-5.4-nano
OPENAI_AMBIENT_CONTEXT_TIMEOUT_MS=20000
PARALLEL_API_KEY=

# Optional API-local URL/port overrides.
# API_PORT=4000
# API_BASE_URL=http://localhost:4000
# CALENDAR_WEBHOOK_BASE_URL=
# NEXT_PUBLIC_WEB_URL=http://localhost:3000
# ASSISTANT_SERVICE_URL=http://localhost:4100
# LIVEKIT_DIAL_IN_NUMBER=

# Optional API-local calendar OAuth overrides. Repo-root `.env` can also define these.
# GOOGLE_CALENDAR_CLIENT_ID=
# GOOGLE_CALENDAR_CLIENT_SECRET=
# GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:4000/v1/integrations/calendar/google_calendar/callback
# OUTLOOK_CALENDAR_CLIENT_ID=
# OUTLOOK_CALENDAR_CLIENT_SECRET=
# OUTLOOK_CALENDAR_REDIRECT_URI=http://localhost:4000/v1/integrations/calendar/outlook_calendar/callback

# Workspace invitations (Resend). Leave RESEND_API_KEY empty in local dev to
# skip sending; invitations are still created.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Ready <invitations@ready.app>
WORKSPACE_INVITE_EXPIRY_DAYS=14

# Automatic meeting-based memory (apply migrations before starting the API).
MEMORY_ENABLED=true

# Enable only after privacy review and web/API deployment together.
GUEST_RECOGNITION_ENABLED=false

# Same random secret (at least 32 characters) on web and API for guest proxy rate limiting.
# GUEST_RECOGNITION_PROXY_SECRET=

# Realtime finalized-speech tracker; apply migrations 0122/0123 before enabling.
MEETING_TRACKER_ENABLED=false
MEETING_TRACKER_MODEL=gpt-6-luna
