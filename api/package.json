{
	"name": "@readymeet/api",
	"version": "0.1.0",
	"license": "BUSL-1.1",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "corepack pnpm --filter @readymeet/db generate && NODE_ENV=development tsx watch index.ts",
		"build": "tsc -p tsconfig.build.json",
		"start": "corepack pnpm --filter @readymeet/db generate && NODE_ENV=production node --import tsx dist/index.js",
		"typecheck": "tsc --noEmit && tsc -p tsconfig.scripts.json",
		"lint": "eslint adapters application composition domain index.ts ports tests --ext .ts",
		"test": "NODE_ENV=test node --import tsx --import @readymeet/db/testing/content-key-preload --import ./composition/test-preload.ts --test --test-concurrency=1 \"tests/**/*.test.ts\"",
		"setup:stripe-catalog": "tsx scripts/setup-stripe-catalog.ts",
		"maintenance:encrypt-content": "tsx scripts/encrypt-existing-content.ts"
	},
	"dependencies": {
		"@fastify/cors": "^11.1.0",
		"@fastify/rate-limit": "^11.0.0",
		"@readymeet/db": "workspace:*",
		"@readymeet/openai-responses": "workspace:*",
		"@readymeet/shared": "workspace:*",
		"@sentry/node": "^10.65.0",
		"ably": "^2.21.0",
		"dotenv": "^16.5.0",
		"fastify": "^5.12.7",
		"htmlparser2": "8.0.2",
		"jose": "^6.2.2",
		"jsonwebtoken": "^9.0.2",
		"livekit-server-sdk": "^2.13.0",
		"pino": "^10.3.1",
		"stripe": "^22.3.0",
		"undici": "^7.30.1",
		"zod": "^3.24.3"
	},
	"devDependencies": {
		"@types/jsonwebtoken": "^9.0.9"
	}
}
